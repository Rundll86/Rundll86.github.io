{
    "name": "fshrimp",
    "version": "1.0.0",
    "private": true,
    "type": "module",
    "license": "MIT",
    "scripts": {
        "build": "run-s build:site build:claude-thunder build:fscd-src",
        "build:site": "vite build",
        "build:claude-thunder": "pnpm --dir submodules/claude-thunder build",
        "build:fscd-src": "pnpm --dir submodules/fscd-src build",
        "dev": "vite",
        "lint": "run-p lint:*",
        "lint:style": "oxlint .",
        "lint:type": "vue-tsc --noEmit",
        "format": "oxlint --fix ."
    },
    "dependencies": {
        "vue": "^3.5.13"
    },
    "devDependencies": {
        "@types/node": "^25.3.0",
        "@types/victor": "^1.1.5",
        "@vitejs/plugin-vue": "^6.0.8",
        "jiti": "^2.6.1",
        "npm-run-all": "^4.1.5",
        "oxlint": "^1.78.0",
        "planck": "^1.4.2",
        "typescript": "^5.9.3",
        "vecjs": "^1.1.2",
        "victor": "^1.1.0",
        "vite": "^8.2.1",
        "vue-tsc": "^3.3.9"
    },
    "pnpm": {}
}